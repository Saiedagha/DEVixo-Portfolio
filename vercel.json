{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd devixo-v2 && npm install",
  "buildCommand": "cd devixo-v2 && npm run build:prod",
  "outputDirectory": "devixo-v2/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    }
  ]
}
